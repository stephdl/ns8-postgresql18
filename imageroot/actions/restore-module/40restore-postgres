set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

mkdir -vp restore
cat - >restore/postgresql_restore.sh <<'EOS'
# The dump is already stripped of CREATE ROLE postgres by module-dump-state, so
# any error here is a real one and must fail the restore.
psql -U postgres -v ON_ERROR_STOP=on -f /tmp/postgresql.pg_dump
ec=$?
docker_temp_server_stop
exit $ec
EOS

# Override the image /docker-entrypoint-initdb.d contents, to restore the
# DB dump file. The container will be stopped at the end
# pgdata is mounted on /var/lib/postgresql, not data/: since 18 the upstream
# image moved PGDATA to /var/lib/postgresql/18/docker

podman run \
    --rm \
    --interactive \
    --network=none \
    --volume=./restore:/docker-entrypoint-initdb.d/:Z \
    --volume=pgdata:/var/lib/postgresql:Z \
    --volume=./postgresql.pg_dump:/tmp/postgresql.pg_dump:Z \
    --replace --name=restore_db \
    --env POSTGRES_USER=postgres \
    --env POSTGRES_PASSWORD=Nethesis,1234 \
    --env TZ=UTC \
    "${POSTGRES_IMAGE}"


# If the restore is successful, clean up:
rm -rfv restore/ postgresql.pg_dump
